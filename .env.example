# Neon Postgres connection string
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Anthropic API key (extraction + geocoding fallback)
ANTHROPIC_API_KEY=sk-ant-...

# Shared admin secret, sent as X-Admin-Token header on ingest/review endpoints
ADMIN_TOKEN=choose-a-long-random-string

# Optional: Neon dev-branch connection string for rehearsing DDL/bulk writes
# (scripts/apply-00N.mjs, import-landmarks.mjs, backfill-landmarks.mjs take
# dev|prod). Branches auto-delete after 1 day — recreate per rehearsal.
# DEV_DATABASE_URL=postgres://user:pass@dev-branch-host/db?sslmode=require

# Local-only: set to 1 to bypass the admin token while working on the admin UI.
# NEVER set this in a deployed environment — it opens every admin endpoint.
# VITE_OPEN_ADMIN=1
